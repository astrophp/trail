{
    "name": "astrophp/trail",
    "description": "Tracing, cost tracking, and an observability dashboard for the Laravel AI SDK.",
    "keywords": ["laravel", "ai", "llm", "tracing", "observability", "agents"],
    "license": "MIT",
    "homepage": "https://github.com/astrophp/trail",
    "support": {
        "issues": "https://github.com/astrophp/trail/issues",
        "source": "https://github.com/astrophp/trail"
    },
    "authors": [
        {
            "name": "Melih Ucar",
            "homepage": "https://github.com/astrophp"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Astro\\Trail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Astro\\Trail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Astro\\Trail\\TrailServiceProvider"
            ],
            "aliases": {
                "Trail": "Astro\\Trail\\Facades\\Trail"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=-1",
        "test:unit": "pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
