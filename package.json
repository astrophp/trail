{
    "name": "trail",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "catalogue": "vite resources/js/catalogue --config vite.config.ts --port 5175",
        "lint": "eslint . && prettier --check resources/js *.ts *.js *.json",
        "format": "prettier --write resources/js *.ts *.js *.json && eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-check-file": "^3.3.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.3",
        "vitest": "^5.0.3",
        "zod": "^4.6.5"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-table": "^9.2.6",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lucide-react": "^1.52.0",
        "radix-ui": "^1.7.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "shadcn": "^4.21.4",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0"
