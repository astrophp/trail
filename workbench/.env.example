APP_NAME="Trail Workbench"
APP_ENV=local
APP_DEBUG=true

DB_CONNECTION=sqlite
SESSION_DRIVER=file
# DB_DATABASE is unset on purpose: the workbench keeps its database at workbench/database/database.sqlite.

# Leave both keys empty to run every scenario offline against scripted provider responses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
