        {"id": "s2", "type": "step", "sequence": 5, "attempt": 2, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
