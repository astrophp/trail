{
  "description": "Which tool span ran each tool call a step asked for. A case is the spans of one turn, the status of the turn, and for some messages of its transcript (named by the span that stores them and the path in it) the span each tool call is linked to, in order, or null. Every turn has a root agent span r, a first step s1 that asks for the calls, and a second step s2 whose stored input holds the calls again after the prompt. A span with no parent is a child of r; sequence is the order spans were recorded in.",
  "cases": [
    {
      "name": "equal arguments under different key order link",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"a": 1, "b": {"x": 1, "y": 2}}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"b": {"y": 2, "x": 1}, "a": 1}}},
        {"id": "s2", "type": "step", "sequence": 4, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"a": 1, "b": {"x": 1, "y": 2}}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": ["t1"]}
    },
    {
      "name": "same-name calls link by position with equal arguments",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}, {"id": "c2", "name": "lookup", "arguments": {"q": "b"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "t2", "type": "tool", "sequence": 4, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "s2", "type": "step", "sequence": 5, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}, {"id": "c2", "name": "lookup", "arguments": {"q": "b"}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": ["t1", "t2"]}
    },
    {
      "name": "a unique equal-arguments match links although the position does not",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "b"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "t2", "type": "tool", "sequence": 4, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "s2", "type": "step", "sequence": 5, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "b"}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": ["t2"]}
    },
    {
      "name": "two equal candidates give no link",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "b"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "t2", "type": "tool", "sequence": 4, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "t3", "type": "tool", "sequence": 5, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "s2", "type": "step", "sequence": 6, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "b"}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
