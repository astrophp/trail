        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "s2", "type": "step", "sequence": 4, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}]}], "messages_offset": 1}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "b"}}]}},
        {"id": "t2", "type": "tool", "sequence": 5, "name": "lookup", "input": {"arguments": {"q": "b"}}}
      ],
      "expect": {"s2:input.messages.0": [null], "s2:output": ["t2"]}
    },
    {
      "name": "a null call id links the call but gives no link by id",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": null, "name": "lookup", "arguments": {"q": "a"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "s2", "type": "step", "sequence": 4, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": null, "name": "lookup", "arguments": {"q": "a"}}]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": [null]}
    },
    {
      "name": "a call without a string name never links",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": null, "arguments": {"q": "a"}}, "stray"]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "s2", "type": "step", "sequence": 4, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": null, "arguments": {"q": "a"}}, "stray"]}], "messages_offset": 1}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": [null, null]}
    },
    {
      "name": "the last step's calls link directly even when their ids repeat",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}, {"id": "c1", "name": "lookup", "arguments": {"q": "b"}}, {"id": null, "name": "search", "arguments": {"q": "c"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "t2", "type": "tool", "sequence": 4, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "t3", "type": "tool", "sequence": 5, "name": "search", "input": {"arguments": {"q": "c"}}}
      ],
      "expect": {"s1:output": ["t1", "t2", "t3"]}
    },
    {
      "name": "the last step's calls link by position, then by unique arguments",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}, {"id": "c2", "name": "lookup", "arguments": {"q": "c"}}, {"id": "c3", "name": "lookup", "arguments": {"q": "b"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "t2", "type": "tool", "sequence": 4, "name": "lookup", "input": {"arguments": {"q": "b"}}},
        {"id": "t3", "type": "tool", "sequence": 5, "name": "lookup", "input": {"arguments": {"q": "c"}}}
      ],
      "expect": {"s1:output": ["t1", "t3", "t2"]}
    },
    {
      "name": "each step links only the tools recorded between it and the next step",
      "spans": [
        {"id": "r", "type": "agent", "sequence": 1, "input": {"prompt": "p"}},
        {"id": "s1", "type": "step", "sequence": 2, "input": {"messages": [{"role": "user", "content": "p"}], "messages_offset": 0}, "output": {"text": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}]}},
        {"id": "t1", "type": "tool", "sequence": 3, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "s2", "type": "step", "sequence": 4, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c1", "name": "lookup", "arguments": {"q": "a"}}]}, {"role": "tool_result", "content": null, "tool_results": [{"id": "c1", "name": "lookup", "result": "x"}]}], "messages_offset": 1}, "output": {"text": "", "tool_calls": [{"id": "c2", "name": "lookup", "arguments": {"q": "a"}}]}},
        {"id": "t2", "type": "tool", "sequence": 5, "name": "lookup", "input": {"arguments": {"q": "a"}}},
        {"id": "s3", "type": "step", "sequence": 6, "input": {"messages": [{"role": "assistant", "content": "", "tool_calls": [{"id": "c2", "name": "lookup", "arguments": {"q": "a"}}]}, {"role": "tool_result", "content": null, "tool_results": [{"id": "c2", "name": "lookup", "result": "x"}]}], "messages_offset": 3}, "output": {"text": "done", "tool_calls": []}}
      ],
      "expect": {"s2:input.messages.0": ["t1"], "s3:input.messages.0": ["t2"]}
    }
  ]
}
